# UmByul 서버 배포 시크릿. 이 파일을 .env로 복사해 값 채우기(.env는 커밋 금지).
# .NET 설정 키의 ':'는 env에서 '__'(더블 언더스코어)로 표기.

# ── Supabase ──
SUPABASE__URL=https://ygrieypnrqffxmchkhsa.supabase.co
SUPABASE__PUBLISHABLE_KEY=
SUPABASE__SECRET_KEY=
# SUPABASE__JWKS_URL=          # 비우면 URL에서 자동 유도

# ── DB (Supabase Session Pooler, 서울) ──
DATABASE__HOST=
DATABASE__PORT=5432
DATABASE__DATABASE=
DATABASE__USER=
DATABASE__PASSWORD=

# ── Spotify ──
SPOTIFY__CLIENT_ID=
SPOTIFY__CLIENT_SECRET=

# ── Cloudflare R2 (아바타 저장) ──
STORAGE__BUCKET_NAME=
STORAGE__URL=
STORAGE__PUBLIC_KEY=
STORAGE__SECRET_KEY=

# ── Admin ──
ADMIN__BOOTSTRAP_USERNAME=
ADMIN__BOOTSTRAP_PASSWORD=
ADMIN__UPLOAD_SECRET=          # Api·Admin 공통(공지 이미지 업로드 인증). 긴 랜덤 문자열
