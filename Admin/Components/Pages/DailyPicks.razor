@page "/daily-picks"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits AdminPageBase
@using Admin.Data
@using Microsoft.AspNetCore.Components.Authorization
@inject AdminDb Db
@inject AuthenticationStateProvider AuthState

<PageTitle>오늘의 음악</PageTitle>

<div class="page-header">
    <h1>오늘의 음악</h1>
    <p class="subtitle">Discover 상단 데일리 픽 큐입니다. 순서대로 등록만 해두면 매일 오전 6시(KST)에 큐 맨 위 곡이 자동으로 노출돼요. 날짜 지정은 필요 없습니다. Spotify ID만 넣으면 이름·커버는 자동 표시됩니다.</p>
</div>

@if (Error is not null) { <div class="alert alert-danger py-2">@Error</div> }
@if (notice is not null) { <div class="alert @(noticeErr ? "alert-danger" : "alert-success") py-2">@notice</div> }

@if (!Db.Configured)
{
    <div class="alert alert-warning">DATABASE 설정이 없습니다.</div>
}
else
{
    @* 대기 큐 *@
    <div class="card mb-4">
        <div class="card-toolbar">
            <span class="toolbar-count">대기 큐 @(queue.Count)곡</span>
            <button class="btn btn-sm btn-primary ms-auto" @onclick="ToggleAdd">+ 새 픽</button>
        </div>

        @if (adding)
        {
            <div class="card-body border-bottom">
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <select class="form-select form-select-sm" style="width:auto" @bind="targetType">
                        <option value="track">곡</option>
                        <option value="album">앨범</option>
                    </select>
                    <input class="form-control form-control-sm font-monospace" style="width:280px" placeholder="Spotify ID" @bind="spotifyId" />
                    <input class="form-control form-control-sm" style="width:220px" placeholder="메모 (선택)" @bind="note" />
                    <button class="btn btn-sm btn-primary" @onclick="Add" disabled="@Busy">큐에 추가</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => adding = false">닫기</button>
                    <span class="text-muted small">트랙/앨범 페이지 URL의 마지막 ID를 붙여넣으세요. 큐 맨 뒤에 추가됩니다.</span>
                </div>
            </div>
        }

        <table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th style="width:7rem">순서</th><th style="width:5rem">종류</th><th>Spotify ID</th><th>메모</th><th style="width:5rem"></th></tr></thead>
            <tbody>
                @if (queue.Count == 0)
                {
                    <tr><td colspan="5" class="empty-state"><span class="empty-icon">☆</span>대기 중인 픽이 없습니다. "+ 새 픽"으로 큐에 추가하세요.</td></tr>
                }
                else
                {
                    @for (int i = 0; i < queue.Count; i++)
                    {
                        var row = queue[i];
                        var idx = i;
                        <tr>
                            <td class="text-muted">
                                @(idx + 1)
                                <span class="ms-1">
                                    <button class="btn btn-link btn-sm p-0 me-1" @onclick="() => Move(row, true)" disabled="@(Busy || idx == 0)" title="위로">↑</button>
                                    <button class="btn btn-link btn-sm p-0" @onclick="() => Move(row, false)" disabled="@(Busy || idx == queue.Count - 1)" title="아래로">↓</button>
                                </span>
                            </td>
                            <td class="text-muted">@(row.TargetType == "album" ? "앨범" : "곡")</td>
                            <td class="text-muted small font-monospace text-truncate" style="max-width:16rem">@row.SpotifyId</td>
                            <td class="text-muted small text-truncate" style="max-width:18rem">@(row.Note ?? "—")</td>
                            <td class="text-end row-actions">
                                <button class="btn btn-link btn-sm p-0 text-danger" @onclick="() => Delete(row)" disabled="@Busy">삭제</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @* 지난 픽(노출 이력) *@
    <div class="card">
        <div class="card-toolbar">
            <span class="toolbar-count">지난 픽 @(history.Count)곡</span>
        </div>
        <table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th style="width:9rem">노출일</th><th style="width:5rem">종류</th><th>Spotify ID</th><th>메모</th></tr></thead>
            <tbody>
                @if (history.Count == 0)
                {
                    <tr><td colspan="4" class="empty-state"><span class="empty-icon">♪</span>아직 노출된 픽이 없습니다.</td></tr>
                }
                else
                {
                    @foreach (var row in history)
                    {
                        <tr>
                            <td class="@(row.ShownDate == Today ? "fw-semibold" : "text-muted")">
                                @(row.ShownDate?.ToString("yyyy-MM-dd") ?? "—")
                                @if (row.ShownDate == Today) { <span class="badge bg-success ms-1">노출 중</span> }
                            </td>
                            <td class="text-muted">@(row.TargetType == "album" ? "앨범" : "곡")</td>
                            <td class="text-muted small font-monospace text-truncate" style="max-width:16rem">@row.SpotifyId</td>
                            <td class="text-muted small text-truncate" style="max-width:18rem">@(row.Note ?? "—")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<DailyPickAdminRow> queue = [];
    private List<DailyPickAdminRow> history = [];
    private bool adding;
    private string targetType = "track";
    private string spotifyId = "";
    private string note = "";
    private string? notice;
    private bool noticeErr;

    // 현재 노출 판정용 오늘 = KST 06:00 롤오버 기준 = (KST now - 6h) = UTC + 3h 의 날짜.
    private static DateOnly Today => DateOnly.FromDateTime(DateTime.UtcNow.AddHours(3));

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() => await LoadAsync(async () =>
    {
        queue = await Db.ListDailyPickQueueAsync();
        history = await Db.ListDailyPickHistoryAsync();
    });

    private void ToggleAdd()
    {
        adding = !adding;
        targetType = "track";
        spotifyId = "";
        note = "";
        notice = null;
    }

    private async Task Add() => await RunAsync(async () =>
    {
        var (ok, err) = await Db.AddDailyPickAsync(targetType, spotifyId, note, await CurrentActor());
        noticeErr = !ok;
        notice = ok ? "큐에 추가됨" : err;
        if (ok) { spotifyId = ""; note = ""; await Load(); }
    });

    private async Task Move(DailyPickAdminRow row, bool up) => await RunAsync(async () =>
    {
        var (ok, err) = await Db.MoveDailyPickAsync(row.Id, up, await CurrentActor());
        if (!ok) { noticeErr = true; notice = err; return; }
        await Load();
    });

    private Task Delete(DailyPickAdminRow row) => RunAsync(async () =>
    {
        await Db.DeleteDailyPickAsync(row.Id, await CurrentActor());
        noticeErr = false; notice = "삭제됨";
        await Load();
    }, confirm: "이 픽을 삭제할까요?");

    private async Task<Actor> CurrentActor()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        Guid? id = Guid.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var g) ? g : null;
        return new Actor(id, user.Identity?.Name ?? "?");
    }
}
