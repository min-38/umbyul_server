@page "/admins"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits AdminPageBase
@using Admin.Data
@using Microsoft.AspNetCore.Components.Authorization
@inject AdminDb Db
@inject AuthenticationStateProvider AuthState

<PageTitle>관리자</PageTitle>

<div class="page-header">
    <h1>관리자</h1>
    <p class="subtitle">관리자 계정을 관리합니다.</p>
</div>

@if (Error is not null)
{
    <div class="alert alert-danger py-2">@Error</div>
}

@if (!Db.Configured)
{
    <div class="alert alert-warning">DATABASE 설정이 없습니다.</div>
}
else
{
    <div class="card mb-4" style="max-width:520px">
        <div class="card-body">
            <h6 class="card-title text-muted mb-3">관리자 계정</h6>
            <table class="table table-sm align-middle mb-3">
                <thead><tr><th>아이디</th><th>생성일</th></tr></thead>
                <tbody>
                    @foreach (var a in admins)
                    {
                        <tr><td>@a.Username</td><td class="small text-muted">@a.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td></tr>
                    }
                </tbody>
            </table>

            @if (msg is not null)
            {
                <p class="@(ok ? "text-success" : "text-danger") small">@msg</p>
            }
            <div class="d-flex gap-2">
                <input class="form-control form-control-sm" placeholder="아이디" @bind="newUser" />
                <input class="form-control form-control-sm" type="password" placeholder="비밀번호(8자+)" @bind="newPass" />
                <button class="btn btn-sm btn-primary text-nowrap" @onclick="Add" disabled="@Busy">추가</button>
            </div>
        </div>
    </div>
}

@code {
    private List<AdminRow> admins = [];
    private string newUser = "";
    private string newPass = "";
    private string? msg;
    private bool ok;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() => await LoadAsync(async () => admins = await Db.ListAdminsAsync());

    private async Task Add()
    {
        msg = null;
        var u = newUser.Trim();
        if (u.Length < 2) { ok = false; msg = "아이디는 2자 이상."; return; }
        if (newPass.Length < 8) { ok = false; msg = "비밀번호는 8자 이상."; return; }

        await RunAsync(async () =>
        {
            var created = await Db.CreateAdminAsync(u, BCrypt.Net.BCrypt.HashPassword(newPass), await CurrentActor());
            if (created)
            {
                ok = true; msg = $"'{u}' 추가됨.";
                newUser = ""; newPass = "";
                await Load();
            }
            else { ok = false; msg = "이미 있는 아이디입니다."; }
        });
    }

    private async Task<Actor> CurrentActor()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        Guid? id = Guid.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var g) ? g : null;
        return new Actor(id, user.Identity?.Name ?? "?");
    }
}
