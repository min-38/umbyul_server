@page "/admins"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits AdminPageBase
@using Admin.Data
@using Microsoft.AspNetCore.Components.Authorization
@inject AdminDb Db
@inject AuthenticationStateProvider AuthState

<PageTitle>관리자</PageTitle>

<div class="page-header">
    <h1>관리자</h1>
    <p class="subtitle">관리자 계정을 관리합니다.</p>
</div>

@if (Error is not null)
{
    <div class="alert alert-danger py-2">@Error</div>
}

@if (!Db.Configured)
{
    <div class="alert alert-warning">DATABASE 설정이 없습니다.</div>
}
else
{
    <div class="card mb-4" style="max-width:520px">
        <div class="card-toolbar">
            <span class="toolbar-count">@(admins.Count)명</span>
        </div>
        <table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th>아이디</th><th>생성일</th><th>상태</th><th class="text-end">조치</th></tr></thead>
            <tbody>
                @if (admins.Count == 0)
                {
                    <tr><td colspan="4" class="empty-state"><span class="empty-icon">∅</span>관리자가 없습니다.</td></tr>
                }
                else
                {
                    @foreach (var a in admins)
                    {
                        <tr>
                            <td>
                                @a.Username
                                @if (a.Id == myId) { <span class="badge bg-body-tertiary text-muted border ms-1">나</span> }
                            </td>
                            <td class="small text-muted">@a.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                            <td>
                                @if (a.IsActive) { <span class="badge bg-success">활성</span> }
                                else { <span class="badge bg-secondary">비활성</span> }
                            </td>
                            <td class="text-end row-actions">
                                @if (a.Id != myId)
                                {
                                    @if (a.IsActive)
                                    {
                                        <button class="btn btn-sm btn-outline-warning" @onclick="() => ToggleActive(a, false)" disabled="@Busy">비활성화</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-success" @onclick="() => ToggleActive(a, true)" disabled="@Busy">활성화</button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="card edit-card mb-4" style="max-width:520px">
        <div class="card-body">
            <h6 class="card-title text-muted mb-3">관리자 추가</h6>
            @if (msg is not null)
            {
                <p class="@(ok ? "text-success" : "text-danger") small">@msg</p>
            }
            <div class="d-flex gap-2">
                <input class="form-control form-control-sm" placeholder="아이디" @bind="newUser" />
                <input class="form-control form-control-sm" type="password" placeholder="비밀번호(8자+)" @bind="newPass" />
                <button class="btn btn-sm btn-primary text-nowrap" @onclick="Add" disabled="@Busy">추가</button>
            </div>
        </div>
    </div>

    <div class="card" style="max-width:520px">
        <div class="card-body">
            <h6 class="card-title text-muted mb-3">내 비밀번호 변경</h6>
            <div class="d-flex flex-column gap-2" style="max-width:300px">
                <input class="form-control form-control-sm" type="password" placeholder="현재 비밀번호" @bind="myCurPass" />
                <div class="d-flex gap-2">
                    <input class="form-control form-control-sm" type="password" placeholder="새 비밀번호(8자+)" @bind="myNewPass" />
                    <button class="btn btn-sm btn-primary text-nowrap" @onclick="ChangePassword" disabled="@Busy">변경</button>
                </div>
            </div>
            @if (pwMsg is not null)
            {
                <p class="@(pwOk ? "text-success" : "text-danger") small mt-2 mb-0">@pwMsg</p>
            }
        </div>
    </div>
}

@code {
    private List<AdminRow> admins = [];
    private string newUser = "";
    private string newPass = "";
    private string? msg;
    private bool ok;
    private Guid? myId;
    private string myCurPass = "";
    private string myNewPass = "";
    private string? pwMsg;
    private bool pwOk;

    protected override async Task OnInitializedAsync()
    {
        myId = (await CurrentActor()).Id;
        await Load();
    }

    private async Task Load() => await LoadAsync(async () => admins = await Db.ListAdminsAsync());

    private Task ToggleActive(AdminRow a, bool active) => RunAsync(async () =>
    {
        var (okr, err) = await Db.SetAdminActiveAsync(a.Id, active, await CurrentActor());
        if (!okr)
        {
            ok = false;
            msg = err == "LAST_ADMIN" ? "마지막 활성 관리자는 비활성화할 수 없습니다." : "처리하지 못했습니다.";
        }
        else { msg = null; await Load(); }
    });

    private async Task ChangePassword()
    {
        pwMsg = null;
        if (myCurPass.Length == 0) { pwOk = false; pwMsg = "현재 비밀번호를 입력하세요."; return; }
        if (myNewPass.Length < 8) { pwOk = false; pwMsg = "비밀번호는 8자 이상."; return; }
        if (myId is not { } id) { pwOk = false; pwMsg = "세션을 확인할 수 없습니다."; return; }
        await RunAsync(async () =>
        {
            var changed = await Db.ChangeAdminPasswordAsync(id, myCurPass, BCrypt.Net.BCrypt.HashPassword(myNewPass), await CurrentActor());
            if (changed) { pwOk = true; pwMsg = "변경되었습니다."; myNewPass = ""; myCurPass = ""; }
            else { pwOk = false; pwMsg = "현재 비밀번호가 올바르지 않습니다."; }
        });
    }

    private async Task Add()
    {
        msg = null;
        var u = newUser.Trim();
        if (u.Length < 2) { ok = false; msg = "아이디는 2자 이상."; return; }
        if (newPass.Length < 8) { ok = false; msg = "비밀번호는 8자 이상."; return; }

        await RunAsync(async () =>
        {
            var created = await Db.CreateAdminAsync(u, BCrypt.Net.BCrypt.HashPassword(newPass), await CurrentActor());
            if (created)
            {
                ok = true; msg = $"'{u}' 추가됨.";
                newUser = ""; newPass = "";
                await Load();
            }
            else { ok = false; msg = "이미 있는 아이디입니다."; }
        });
    }

    private async Task<Actor> CurrentActor()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        Guid? id = Guid.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var g) ? g : null;
        return new Actor(id, user.Identity?.Name ?? "?");
    }
}
