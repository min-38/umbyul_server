@page "/admins"
@attribute [Authorize]
@rendermode InteractiveServer
@using Admin.Data
@using Microsoft.AspNetCore.Components.Authorization
@inject AdminDb Db
@inject AuthenticationStateProvider AuthState

<PageTitle>관리자</PageTitle>
<h1>관리자</h1>

@if (!Db.Configured)
{
    <div class="alert alert-warning">DATABASE 설정이 없습니다.</div>
}
else
{
    <table class="table table-sm w-auto">
        <thead><tr><th>아이디</th><th>생성일</th></tr></thead>
        <tbody>
            @foreach (var a in admins)
            {
                <tr><td>@a.Username</td><td class="small text-muted">@a.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td></tr>
            }
        </tbody>
    </table>

    <h5 class="mt-3">관리자 추가</h5>
    @if (msg is not null)
    {
        <p class="@(ok ? "text-success" : "text-danger")">@msg</p>
    }
    <div class="d-flex gap-2" style="max-width:420px">
        <input class="form-control form-control-sm" placeholder="아이디" @bind="newUser" />
        <input class="form-control form-control-sm" type="password" placeholder="비밀번호(8자+)" @bind="newPass" />
        <button class="btn btn-sm btn-primary" @onclick="Add">추가</button>
    </div>

    <h2 class="mt-4">감사 로그</h2>
    <table class="table table-sm">
        <thead><tr><th>시각</th><th>관리자</th><th>동작</th><th>대상</th><th>상세</th></tr></thead>
        <tbody>
            @foreach (var a in actions)
            {
                <tr>
                    <td class="small">@a.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")</td>
                    <td class="small">@a.AdminUsername</td>
                    <td class="small"><code>@a.Action</code></td>
                    <td class="small">@a.Target</td>
                    <td class="small">@a.Detail</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<AdminRow> admins = [];
    private List<AdminActionRow> actions = [];
    private string newUser = "";
    private string newPass = "";
    private string? msg;
    private bool ok;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        admins = await Db.ListAdminsAsync();
        actions = await Db.RecentActionsAsync(50);
    }

    private async Task Add()
    {
        msg = null;
        var u = newUser.Trim();
        if (u.Length < 2) { ok = false; msg = "아이디는 2자 이상."; return; }
        if (newPass.Length < 8) { ok = false; msg = "비밀번호는 8자 이상."; return; }

        var created = await Db.CreateAdminAsync(u, BCrypt.Net.BCrypt.HashPassword(newPass), await CurrentActor());
        if (created)
        {
            ok = true; msg = $"'{u}' 추가됨.";
            newUser = ""; newPass = "";
            await Load();
        }
        else { ok = false; msg = "이미 있는 아이디입니다."; }
    }

    private async Task<Actor> CurrentActor()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        Guid? id = Guid.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var g) ? g : null;
        return new Actor(id, user.Identity?.Name ?? "?");
    }
}
