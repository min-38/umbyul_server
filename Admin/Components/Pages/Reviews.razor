@page "/reviews"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits AdminPageBase
@using Admin.Data
@inject AdminDb Db
@inject AuthenticationStateProvider AuthState

<PageTitle>리뷰 모더레이션</PageTitle>

<div class="page-header">
    <h1>리뷰</h1>
    <p class="subtitle">신고 없이도 부적절한 리뷰를 검색해 삭제하고, 작성자를 제재합니다.</p>
</div>

@if (!Db.Configured)
{
    <div class="alert alert-warning">DATABASE 설정이 없습니다.</div>
}
else
{
    <div class="card mb-3">
        <div class="card-toolbar">
            @if (reviews is not null) { <span class="toolbar-count">@(reviews.Count)개</span> }
            <input class="form-control form-control-sm" style="max-width:320px" placeholder="유저명·리뷰 내용 검색" @bind="search" @bind:event="oninput" @onkeyup="OnKey" />
            <button class="btn btn-sm btn-primary text-nowrap" @onclick="Load" disabled="@Busy">검색</button>
        </div>
    </div>

    @if (Error is not null)
    {
        <div class="alert alert-danger py-2">@Error</div>
    }

    @if (reviews is null)
    {
        <p class="text-muted">불러오는 중…</p>
    }
    else if (reviews.Count == 0)
    {
        <div class="card"><div class="empty-state"><span class="empty-icon">♪</span>리뷰가 없습니다.</div></div>
    }
    else
    {
        @foreach (var r in reviews)
        {
            <div class="card mb-2 @(deletingId == r.Id || sanctionId == r.Id ? "edit-card" : "")" @key="r.Id">
                <div class="card-body py-2">
                    <div class="d-flex align-items-center gap-2 mb-1 small">
                        <span class="badge @(r.TargetType == "track" ? "bg-primary" : "bg-success")">@(r.TargetType == "track" ? "곡" : "앨범")</span>
                        <span class="fw-semibold">@(r.Name ?? "(제목 미상)")</span>
                        @if (r.Artist is not null) { <span class="text-muted">· @r.Artist</span> }
                        <span class="ms-auto fw-semibold">★ @r.Score.ToString("0.0")</span>
                    </div>
                    <p class="mb-1" style="white-space:pre-wrap">@r.Review</p>
                    <div class="d-flex align-items-center gap-2 small text-muted">
                        <span class="fw-semibold text-body">@r.Username</span>
                        <span>· @r.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                        <span class="ms-auto"></span>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ToggleDelete(r.Id)" disabled="@Busy">삭제</button>
                        <button class="btn btn-sm btn-outline-dark" @onclick="() => ToggleSanction(r.Id)" disabled="@Busy">작성자 제재</button>
                    </div>

                    @if (deletingId == r.Id)
                    {
                        <div class="mt-2 d-flex gap-2 align-items-center">
                            <input class="form-control form-control-sm" placeholder="삭제 사유(선택)" @bind="deleteReason" style="max-width:320px" />
                            <button class="btn btn-sm btn-danger" @onclick="() => Delete(r.Id)" disabled="@Busy">삭제 확정</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => deletingId = null" disabled="@Busy">취소</button>
                        </div>
                    }
                    @if (sanctionId == r.Id)
                    {
                        <div class="mt-2 bg-body-tertiary rounded p-2">
                            <SanctionControls UserId="r.UserId" OnDone="Load" />
                        </div>
                    }
                </div>
            </div>
        }

        @if (hasMore)
        {
            <div class="text-center mt-3">
                <button class="btn btn-sm btn-outline-secondary" @onclick="LoadMore" disabled="@Busy">더 보기</button>
            </div>
        }
    }
}

@code {
    private const int PageSize = 50;
    private List<ReviewRow>? reviews;
    private string search = "";
    private Guid? deletingId;
    private Guid? sanctionId;
    private string deleteReason = "";
    private int offset;
    private bool hasMore;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        reviews = null;
        offset = 0;
        await LoadAsync(async () =>
        {
            var page = await Db.ListReviewsAsync(search, 0, PageSize);
            reviews = page;
            offset = page.Count;
            hasMore = page.Count == PageSize;
        });
    }

    private Task LoadMore() => RunAsync(async () =>
    {
        var page = await Db.ListReviewsAsync(search, offset, PageSize);
        reviews!.AddRange(page);
        offset += page.Count;
        hasMore = page.Count == PageSize;
    });

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Load();
    }

    private void ToggleDelete(Guid id)
    {
        deletingId = deletingId == id ? null : id;
        deleteReason = "";
        sanctionId = null;
    }

    private void ToggleSanction(Guid id)
    {
        sanctionId = sanctionId == id ? null : id;
        deletingId = null;
    }

    private Task Delete(Guid id) => RunAsync(async () =>
    {
        await Db.SoftDeleteRatingAsync(id, string.IsNullOrWhiteSpace(deleteReason) ? null : deleteReason.Trim(), await CurrentActor());
        deletingId = null;
        await Load();
    }, confirm: "이 리뷰를 삭제할까요? 공개에서 즉시 숨겨집니다.");

    private async Task<Actor> CurrentActor()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        Guid? id = Guid.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var g) ? g : null;
        return new Actor(id, user.Identity?.Name ?? "?");
    }
}
