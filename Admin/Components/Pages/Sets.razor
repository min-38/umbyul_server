@page "/sets"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits AdminPageBase
@using Admin.Data
@inject AdminDb Db
@inject AuthenticationStateProvider AuthState

<PageTitle>믹스 모더레이션</PageTitle>

<div class="page-header">
    <h1>믹스</h1>
    <p class="subtitle">신고 없이도 부적절한 믹스를 검색해 삭제하고, 소유자를 제재합니다.</p>
</div>

@if (!Db.Configured)
{
    <div class="alert alert-warning">DATABASE 설정이 없습니다.</div>
}
else
{
    <div class="mb-3 d-flex gap-2" style="max-width:480px">
        <input class="form-control form-control-sm" placeholder="제목·소유자명 검색" @bind="search" @bind:event="oninput" @onkeyup="OnKey" />
        <button class="btn btn-sm btn-primary text-nowrap" @onclick="Load" disabled="@Busy">검색</button>
    </div>

    @if (Error is not null)
    {
        <div class="alert alert-danger py-2">@Error</div>
    }

    @if (sets is null)
    {
        <p class="text-muted">불러오는 중…</p>
    }
    else if (sets.Count == 0)
    {
        <div class="card"><div class="card-body text-center text-muted py-5">믹스가 없습니다.</div></div>
    }
    else
    {
        @foreach (var s in sets)
        {
            <div class="card mb-2" @key="s.Id">
                <div class="card-body py-2">
                    <div class="d-flex align-items-center gap-2 mb-1 small">
                        <span class="fw-semibold">@s.Title</span>
                        <span class="badge bg-secondary">@(s.TrackCount)곡</span>
                        <span class="ms-auto text-muted">@s.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                    </div>
                    @if (s.Note is not null) { <p class="mb-1 small text-muted" style="white-space:pre-wrap">@s.Note</p> }
                    <div class="d-flex align-items-center gap-2 small text-muted">
                        <span class="fw-semibold text-body">@s.OwnerUsername</span>
                        <span class="ms-auto"></span>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ToggleDelete(s.Id)" disabled="@Busy">삭제</button>
                        <button class="btn btn-sm btn-outline-dark" @onclick="() => ToggleSanction(s.Id)" disabled="@Busy">소유자 제재</button>
                    </div>

                    @if (deletingId == s.Id)
                    {
                        <div class="mt-2 d-flex gap-2 align-items-center">
                            <input class="form-control form-control-sm" placeholder="삭제 사유(선택)" @bind="deleteReason" style="max-width:320px" />
                            <button class="btn btn-sm btn-danger" @onclick="() => Delete(s.Id)" disabled="@Busy">삭제 확정</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => deletingId = null" disabled="@Busy">취소</button>
                        </div>
                    }
                    @if (sanctionId == s.Id)
                    {
                        <div class="mt-2 bg-body-tertiary rounded p-2">
                            <SanctionControls UserId="s.OwnerId" OnDone="Load" />
                        </div>
                    }
                </div>
            </div>
        }

        @if (hasMore)
        {
            <div class="text-center mt-3">
                <button class="btn btn-sm btn-outline-secondary" @onclick="LoadMore" disabled="@Busy">더 보기</button>
            </div>
        }
    }
}

@code {
    private const int PageSize = 50;
    private List<SetRow>? sets;
    private string search = "";
    private Guid? deletingId;
    private Guid? sanctionId;
    private string deleteReason = "";
    private int offset;
    private bool hasMore;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        sets = null;
        offset = 0;
        await LoadAsync(async () =>
        {
            var page = await Db.ListSetsAsync(search, 0, PageSize);
            sets = page;
            offset = page.Count;
            hasMore = page.Count == PageSize;
        });
    }

    private Task LoadMore() => RunAsync(async () =>
    {
        var page = await Db.ListSetsAsync(search, offset, PageSize);
        sets!.AddRange(page);
        offset += page.Count;
        hasMore = page.Count == PageSize;
    });

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Load();
    }

    private void ToggleDelete(Guid id)
    {
        deletingId = deletingId == id ? null : id;
        deleteReason = "";
        sanctionId = null;
    }

    private void ToggleSanction(Guid id)
    {
        sanctionId = sanctionId == id ? null : id;
        deletingId = null;
    }

    private Task Delete(Guid id) => RunAsync(async () =>
    {
        await Db.SoftDeleteSetAsync(id, string.IsNullOrWhiteSpace(deleteReason) ? null : deleteReason.Trim(), await CurrentActor());
        deletingId = null;
        await Load();
    }, confirm: "이 믹스를 삭제할까요? 공개에서 즉시 숨겨집니다.");

    private async Task<Actor> CurrentActor()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        Guid? id = Guid.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var g) ? g : null;
        return new Actor(id, user.Identity?.Name ?? "?");
    }
}
