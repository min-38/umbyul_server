@page "/inquiries"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits AdminPageBase
@using Admin.Data
@using Microsoft.AspNetCore.Components.Authorization
@inject AdminDb Db
@inject AuthenticationStateProvider AuthState

<PageTitle>문의</PageTitle>

<div class="page-header">
    <h1>문의</h1>
    <p class="subtitle">접수된 문의를 열람하고 처리 완료를 표시합니다. 답변은 이메일로 직접 보내세요.</p>
</div>

<div class="mb-3 d-flex flex-wrap align-items-center gap-1">
    <span class="text-muted small me-1">보기</span>
    <button class="btn btn-sm @(filter == false ? "btn-primary" : "btn-outline-secondary")" @onclick="() => Load(false)">미처리</button>
    <button class="btn btn-sm @(filter is null ? "btn-primary" : "btn-outline-secondary")" @onclick="() => Load(null)">전체</button>
    <input class="form-control form-control-sm ms-2" style="width:200px" placeholder="제목·내용·이메일 검색" @bind="search" @bind:event="oninput" @onkeyup="OnKey" />
    <select class="form-select form-select-sm" style="width:auto" @bind="category" @bind:after="() => Load(filter)">
        <option value="">전체 카테고리</option>
        @foreach (var c in categories)
        {
            <option value="@c">@c</option>
        }
    </select>
    <button class="btn btn-sm btn-primary" @onclick="() => Load(filter)" disabled="@Busy">검색</button>
    <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="() => Load(filter)" disabled="@Busy">새로고침</button>
</div>

@if (Error is not null)
{
    <div class="alert alert-danger py-2">@Error</div>
}

@if (!Db.Configured)
{
    <div class="alert alert-warning">DATABASE 설정이 없습니다.</div>
}
else if (items is null)
{
    <p class="text-muted">불러오는 중…</p>
}
else if (items.Count == 0)
{
    <div class="card"><div class="card-body text-center text-muted py-5">문의가 없습니다.</div></div>
}
else
{
    <div class="card">
    <table class="table table-sm table-hover align-middle mb-0">
        <thead><tr><th>카테고리</th><th>이메일</th><th>제목</th><th>접수</th><th>상태</th><th class="text-end">처리</th></tr></thead>
        <tbody>
            @foreach (var q in items)
            {
                <tr style="cursor:pointer" @onclick="() => Toggle(q.Id)">
                    <td>@(string.IsNullOrEmpty(q.Category) ? "—" : q.Category)</td>
                    <td class="small"><a href="mailto:@q.Email" @onclick:stopPropagation>@q.Email</a></td>
                    <td class="text-truncate" style="max-width:22rem">@q.Title</td>
                    <td class="small text-muted">@q.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")</td>
                    <td>
                        @if (q.Handled)
                        {
                            <span class="badge bg-success">처리됨</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">미처리</span>
                        }
                    </td>
                    <td class="text-end" @onclick:stopPropagation>
                        @if (q.Handled)
                        {
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => SetHandled(q.Id, false)" disabled="@Busy">되돌리기</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-success" @onclick="() => SetHandled(q.Id, true)" disabled="@Busy">처리 완료</button>
                        }
                    </td>
                </tr>
                @if (openId == q.Id)
                {
                    <tr class="table-active">
                        <td colspan="6">
                            <div class="small text-muted mb-1">@q.Email · @q.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                            <div class="fw-semibold mb-1">@q.Title</div>
                            <div style="white-space:pre-wrap">@q.Content</div>
                            <div class="mt-2 d-flex gap-2">
                                <a class="btn btn-sm btn-outline-primary" href="mailto:@q.Email?subject=@(Uri.EscapeDataString("[Glitter] Re: " + q.Title))">이메일로 답장</a>
                                @* 이메일 삭제 요청 이행 수단(QA9-5). 확인 후 영구 삭제. *@
                                <button class="btn btn-sm btn-outline-danger ms-auto" @onclick="() => Delete(q.Id)" disabled="@Busy">삭제</button>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    </div>

    @if (hasMore)
    {
        <div class="text-center mt-3">
            <button class="btn btn-sm btn-outline-secondary" @onclick="LoadMore" disabled="@Busy">더 보기</button>
        </div>
    }
}

@code {
    private const int PageSize = 50;
    private List<InquiryRow>? items;
    private bool? filter = false; // 기본: 미처리
    private string search = "";
    private string category = "";
    private List<string> categories = [];
    private Guid? openId;
    private int offset;
    private bool hasMore;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(async () => categories = await Db.InquiryCategoriesAsync());
        await Load(filter);
    }

    private async Task Load(bool? f)
    {
        filter = f;
        items = null;
        offset = 0;
        await LoadAsync(async () =>
        {
            var page = await Db.ListInquiriesAsync(f, search, category, 0, PageSize);
            items = page;
            offset = page.Count;
            hasMore = page.Count == PageSize;
        });
    }

    private Task LoadMore() => RunAsync(async () =>
    {
        var page = await Db.ListInquiriesAsync(filter, search, category, offset, PageSize);
        items!.AddRange(page);
        offset += page.Count;
        hasMore = page.Count == PageSize;
    });

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Load(filter);
    }

    private void Toggle(Guid id) => openId = openId == id ? null : id;

    private Task SetHandled(Guid id, bool handled) => RunAsync(async () =>
    {
        await Db.SetInquiryHandledAsync(id, handled, await CurrentActor());
        await Load(filter);
    });

    // 개별 영구 삭제(QA9-5) — 이메일 삭제 요청 이행. 확인 후 실행.
    private Task Delete(Guid id) => RunAsync(async () =>
    {
        await Db.DeleteInquiryAsync(id, await CurrentActor());
        openId = null;
        await Load(filter);
    }, confirm: "이 문의를 영구 삭제할까요? 되돌릴 수 없습니다.");

    private async Task<Actor> CurrentActor()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        Guid? uid = Guid.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var g) ? g : null;
        return new Actor(uid, user.Identity?.Name ?? "?");
    }
}
