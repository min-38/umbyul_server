@page "/reports"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits AdminPageBase
@using Admin.Data
@using Microsoft.AspNetCore.Components.Authorization
@inject AdminDb Db
@inject AuthenticationStateProvider AuthState
@inject SessionGuard Guard

<PageTitle>신고 처리</PageTitle>

<div class="page-header">
    <h1>신고 처리</h1>
    <p class="subtitle">접수된 신고를 검토하고 리뷰를 조치합니다.</p>
</div>

@if (Error is not null)
{
    <div class="alert alert-danger py-2">@Error</div>
}

@if (!Db.Configured)
{
    <div class="alert alert-warning">DATABASE 설정이 없습니다. user-secrets에 DATABASE:* 를 설정하세요.</div>
}
else if (reports is null)
{
    <p class="text-muted">불러오는 중…</p>
}
else
{
    <div class="card">
    <div class="card-toolbar">
        <span class="toolbar-count">@(reports.Count)건</span>
        <span class="text-muted small me-1">상태</span>
        @foreach (var (key, label) in Filters)
        {
            <button class="btn btn-sm @(filter == key ? "btn-primary" : "btn-outline-secondary")"
                    @onclick="() => Load(key)">@label</button>
        }
        <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="() => Load(filter)" disabled="@Busy">새로고침</button>
    </div>
    <div class="table-scroll">
    <table class="table table-sm table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>대상</th><th>사유</th><th>상세</th><th>신고자</th><th>상태</th><th>시각</th><th class="text-end">조치</th>
            </tr>
        </thead>
        <tbody>
            @if (reports.Count == 0)
            {
                <tr><td colspan="7" class="empty-state"><span class="empty-icon">⚑</span>해당 상태의 신고가 없습니다.</td></tr>
            }
            @foreach (var r in reports)
            {
                <tr>
                    <td>
                        <span class="badge bg-secondary">@TypeLabel(r.TargetType)</span>
                        @if (r.TargetDeleted) { <span class="badge bg-dark">삭제됨</span> }
                        <strong>@r.Title</strong>
                        @if (r.Sub is not null) { <div class="small text-muted">@r.Sub</div> }
                        @if (r.Body is not null) { <div class="small">“@r.Body”</div> }
                    </td>
                    <td>@Reason(r.Reason)</td>
                    <td class="small">@r.Detail</td>
                    <td class="small">@r.Reporter</td>
                    <td><span class="badge @StatusClass(r.Status)">@r.Status</span></td>
                    <td class="small">@r.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")</td>
                    <td class="text-end" style="white-space:nowrap">
                        @if (r.Status != "reviewed")
                        {
                            <button class="btn btn-sm btn-outline-secondary me-1" @onclick='() => SetStatus(r.Id, "reviewed")' disabled="@Busy">검토</button>
                        }
                        @if (r.Status != "resolved")
                        {
                            <button class="btn btn-sm btn-outline-success me-1" @onclick='() => SetStatus(r.Id, "resolved")' disabled="@Busy">해결</button>
                        }
                        @if (r.TargetType != "user" && !r.TargetDeleted)
                        {
                            <button class="btn btn-sm btn-outline-danger me-1" @onclick="() => DeleteTarget(r)" disabled="@Busy">@DeleteLabel(r.TargetType)</button>
                        }
                        @if (r.OffenderId is not null)
                        {
                            <button class="btn btn-sm btn-outline-dark" @onclick="() => ToggleSanction(r.Id)" disabled="@Busy">유저 제재</button>
                        }
                    </td>
                </tr>
                @if (openSanction == r.Id && r.OffenderId is { } oid)
                {
                    <tr class="table-active">
                        <td colspan="7">
                            <div class="small text-muted mb-1">
                                유저 제재 · @(r.OffenderName is null ? "(대상 유저)" : "@" + r.OffenderName)
                            </div>
                            <SanctionControls UserId="oid" ReportId="r.Id" OnDone="() => Load(filter)" />
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    </div>
    </div>

    @if (hasMore)
    {
        <div class="text-center mt-3">
            <button class="btn btn-sm btn-outline-secondary" @onclick="LoadMore" disabled="@Busy">더 보기</button>
        </div>
    }
}

@code {
    private static readonly (string, string)[] Filters =
        [("pending", "대기"), ("reviewed", "검토됨"), ("resolved", "해결됨"), ("", "전체")];

    private const int PageSize = 50;
    private List<ReportRow>? reports;
    private string filter = "pending";
    private Guid? openSanction;
    private int offset;
    private bool hasMore;

    protected override async Task OnInitializedAsync() => await Load(filter);

    private void ToggleSanction(Guid reportId) => openSanction = openSanction == reportId ? null : reportId;

    private async Task Load(string status)
    {
        filter = status;
        reports = null;
        offset = 0;
        await LoadAsync(async () =>
        {
            var page = await Db.GetReportsAsync(status, 0, PageSize);
            reports = page;
            offset = page.Count;
            hasMore = page.Count == PageSize;
        });
    }

    private Task LoadMore() => RunAsync(async () =>
    {
        var page = await Db.GetReportsAsync(filter, offset, PageSize);
        reports!.AddRange(page);
        offset += page.Count;
        hasMore = page.Count == PageSize;
    });

    private async Task<Actor> CurrentActor()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        Guid? id = Guid.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var g) ? g : null;
        return new Actor(id, user.Identity?.Name ?? "?");
    }

    private Task SetStatus(Guid id, string status) => RunAsync(async () =>
    {
        using (Guard.Work())
            await Db.SetReportStatusAsync(id, status, await CurrentActor());
        await Load(filter);
    });

    private Task DeleteTarget(ReportRow r) => RunAsync(async () =>
    {
        using (Guard.Work())
        {
            var actor = await CurrentActor();
            switch (r.TargetType)
            {
                case "rating": await Db.DeleteRatingAndResolveAsync(r.Id, r.TargetId, actor); break;
                case "comment": await Db.DeleteCommentAndResolveAsync(r.Id, r.TargetId, actor); break;
                case "set_comment": await Db.DeleteSetCommentAndResolveAsync(r.Id, r.TargetId, actor); break;
                case "set": await Db.DeleteSetAndResolveAsync(r.Id, r.TargetId, actor); break;
            }
        }
        await Load(filter);
    }, confirm: "이 콘텐츠를 삭제할까요? 공개에서 즉시 숨겨집니다.");

    private static string TypeLabel(string t) => t switch
    {
        "rating" => "리뷰",
        "comment" => "댓글",
        "set_comment" => "믹스 댓글",
        "set" => "믹스",
        _ => "유저",
    };

    private static string DeleteLabel(string t) => t switch
    {
        "rating" => "리뷰 삭제",
        "comment" or "set_comment" => "댓글 삭제",
        "set" => "믹스 삭제",
        _ => "삭제",
    };

    private static string Reason(string r) => r switch
    {
        "not_music" => "음악 무관",
        "inappropriate_profile" => "부적절 프로필",
        "abuse" => "악플·욕설",
        _ => "기타",
    };

    private static string StatusClass(string s) => s switch
    {
        "pending" => "bg-warning text-dark",
        "reviewed" => "bg-info text-dark",
        _ => "bg-success",
    };
}
