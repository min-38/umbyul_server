@page "/audit"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits AdminPageBase
@using Admin.Data
@inject AdminDb Db

<PageTitle>감사 로그</PageTitle>

<div class="page-header">
    <h1>감사 로그</h1>
    <p class="subtitle">관리자 조치 내역입니다.</p>
</div>

@if (Error is not null)
{
    <div class="alert alert-danger py-2">@Error</div>
}

@if (!Db.Configured)
{
    <div class="alert alert-warning">DATABASE 설정이 없습니다.</div>
}
else
{
    <div class="card">
        <div class="card-toolbar">
            <span class="toolbar-count">@(actions?.Count ?? 0)건</span>
            <input class="form-control form-control-sm" style="width:150px" placeholder="동작(action)" @bind="fAction" @bind:event="oninput" @onkeyup="OnKey" />
            <input class="form-control form-control-sm" style="width:150px" placeholder="관리자" @bind="fAdmin" @bind:event="oninput" @onkeyup="OnKey" />
            <select class="form-select form-select-sm" style="width:auto" @bind="fPeriod" @bind:after="Load">
                <option value="">전체 기간</option>
                <option value="1">최근 1일</option>
                <option value="7">최근 7일</option>
                <option value="30">최근 30일</option>
            </select>
            <button class="btn btn-sm btn-primary" @onclick="Load" disabled="@Busy">검색</button>
        </div>
        @if (actions is null)
        {
            <div class="card-body text-muted">불러오는 중…</div>
        }
        else
        {
            <div class="table-scroll">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead><tr><th>시각</th><th>관리자</th><th>동작</th><th>대상</th><th>상세</th></tr></thead>
                    <tbody>
                        @if (actions.Count == 0)
                        {
                            <tr><td colspan="5" class="empty-state"><span class="empty-icon">∅</span>기록이 없습니다.</td></tr>
                        }
                        else
                        {
                            @foreach (var a in actions)
                            {
                                <tr>
                                    <td class="small">@a.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")</td>
                                    <td class="small">@a.AdminUsername</td>
                                    <td class="small"><code>@a.Action</code></td>
                                    <td class="small">@a.Target</td>
                                    <td class="small">@a.Detail</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (actions is not null && hasMore)
    {
        <div class="text-center mt-3">
            <button class="btn btn-sm btn-outline-secondary" @onclick="LoadMore" disabled="@Busy">더 보기</button>
        </div>
    }
}

@code {
    private const int PageSize = 50;
    private List<AdminActionRow>? actions;
    private string fAction = "";
    private string fAdmin = "";
    private string fPeriod = "";
    private int offset;
    private bool hasMore;

    protected override async Task OnInitializedAsync() => await Load();

    private DateTimeOffset? Since() => fPeriod switch
    {
        "1" => DateTimeOffset.UtcNow.AddDays(-1),
        "7" => DateTimeOffset.UtcNow.AddDays(-7),
        "30" => DateTimeOffset.UtcNow.AddDays(-30),
        _ => null,
    };

    private async Task Load()
    {
        actions = null;
        offset = 0;
        await LoadAsync(async () =>
        {
            var page = await Db.RecentActionsAsync(fAction, fAdmin, Since(), 0, PageSize);
            actions = page;
            offset = page.Count;
            hasMore = page.Count == PageSize;
        });
    }

    private Task LoadMore() => RunAsync(async () =>
    {
        var page = await Db.RecentActionsAsync(fAction, fAdmin, Since(), offset, PageSize);
        actions!.AddRange(page);
        offset += page.Count;
        hasMore = page.Count == PageSize;
    });

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Load();
    }
}
