@page "/audit"
@attribute [Authorize]
@rendermode InteractiveServer
@using Admin.Data
@inject AdminDb Db

<PageTitle>감사 로그</PageTitle>

<div class="page-header">
    <h1>감사 로그</h1>
    <p class="subtitle">관리자 조치 내역입니다.</p>
</div>

@if (!Db.Configured)
{
    <div class="alert alert-warning">DATABASE 설정이 없습니다.</div>
}
else
{
    <button class="btn btn-sm btn-outline-secondary mb-3" @onclick="Load">새로고침</button>

    @if (actions is null)
    {
        <p class="text-muted">불러오는 중…</p>
    }
    else if (actions.Count == 0)
    {
        <div class="card"><div class="card-body text-center text-muted py-5">기록이 없습니다.</div></div>
    }
    else
    {
        <div class="card">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th>시각</th><th>관리자</th><th>동작</th><th>대상</th><th>상세</th></tr></thead>
            <tbody>
                @foreach (var a in actions)
                {
                    <tr>
                        <td class="small">@a.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")</td>
                        <td class="small">@a.AdminUsername</td>
                        <td class="small"><code>@a.Action</code></td>
                        <td class="small">@a.Target</td>
                        <td class="small">@a.Detail</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
}

@code {
    private List<AdminActionRow>? actions;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        actions = null;
        actions = await Db.RecentActionsAsync(100);
    }
}
