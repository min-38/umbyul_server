@page "/legal"
@attribute [Authorize]
@rendermode InteractiveServer
@inherits AdminPageBase
@using Admin.Data
@using Microsoft.AspNetCore.Components.Authorization
@inject AdminDb Db
@inject AuthenticationStateProvider AuthState

<PageTitle>약관 · 개인정보</PageTitle>

<div class="page-header">
    <h1>약관 · 개인정보</h1>
    <p class="subtitle">문서 하나를 4개 언어로 함께 관리합니다. 게시(릴리스)는 모든 언어가 작성돼야 가능 — 같은 버전·시행일로 한꺼번에 스냅샷됩니다. 정본은 EN.</p>
</div>

@if (Error is not null)
{
    <div class="alert alert-danger py-2">@Error</div>
}

@if (!Db.Configured)
{
    <div class="alert alert-warning">DATABASE 설정이 없습니다.</div>
}
else
{
    @* 문서 종류 탭 *@
    <ul class="nav nav-pills mb-3">
        <li class="nav-item"><button class="nav-link @(type == "terms" ? "active" : "")" @onclick='() => SelectType("terms")'>이용약관</button></li>
        <li class="nav-item"><button class="nav-link @(type == "privacy" ? "active" : "")" @onclick='() => SelectType("privacy")'>개인정보처리방침</button></li>
    </ul>

    <div class="card mb-4">
        @* 언어 세그먼트 *@
        <div class="card-toolbar">
            <span class="lg-loclabel">언어</span>
            @foreach (var l in Locales)
            {
                var pub = published.GetValueOrDefault(l);
                var has = !string.IsNullOrWhiteSpace(content.GetValueOrDefault(l));
                <button class="btn btn-sm @(l == locale ? "btn-primary" : "btn-outline-secondary")" @onclick="() => locale = l">
                    <span class="legal-dot @(pub ? "dot-pub" : has ? "dot-draft" : "dot-empty")"></span>@l.ToUpperInvariant()@(l == "en" ? " · 정본" : "")
                </button>
            }
            <span class="ms-auto small @(AllFilled ? "text-success" : "text-warning")">
                @if (AllFilled) { <text>4개 언어 작성 완료 — 게시 가능</text> }
                else { <text>미작성: @string.Join(", ", MissingLocales.Select(l => l.ToUpperInvariant()))</text> }
            </span>
        </div>

        @* 편집 툴바 *@
        <div class="card-toolbar">
            <input class="form-control form-control-sm" style="width:150px" placeholder="버전 (예: v1.0)" @bind="version" />
            <span class="input-group input-group-sm" style="width:auto">
                <span class="input-group-text">시행일</span>
                <input type="date" class="form-control form-control-sm" style="width:150px" @bind="effectiveDate" title="미입력 시 게시일" />
            </span>
            <div class="btn-group btn-group-sm ms-auto" role="group">
                <button class="btn @(tab == "edit" ? "btn-secondary" : "btn-outline-secondary")" @onclick='() => tab = "edit"'>편집</button>
                <button class="btn @(tab == "preview" ? "btn-secondary" : "btn-outline-secondary")" @onclick='() => tab = "preview"'>미리보기</button>
            </div>
        </div>

        <div class="card-body">
            @if (tab == "edit")
            {
                <textarea class="form-control font-monospace" rows="20"
                          @bind="CurrentContent" @bind:event="oninput"
                          placeholder="@($"{LocaleLabel(locale)} 내용을 마크다운으로 작성")"></textarea>
            }
            else
            {
                <div class="border rounded p-3" style="min-height:24rem">@((MarkupString)PreviewHtml)</div>
            }

            <div class="d-flex align-items-center gap-2 mt-3 flex-wrap">
                <button class="btn btn-sm btn-outline-secondary" @onclick="SaveDraft" disabled="@Busy">이 언어 초안 저장</button>
                <button class="btn btn-sm btn-primary" @onclick="Publish" disabled="@(Busy || !AllFilled || string.IsNullOrWhiteSpace(version))">
                    게시 (4개 언어)
                </button>
                @if (msg is not null)
                {
                    <span class="small @(err ? "text-danger" : "text-success")">@msg</span>
                }
                @if (!AllFilled)
                {
                    <span class="text-muted small">모든 언어가 작성돼야 게시할 수 있습니다.</span>
                }
            </div>
        </div>
    </div>

    @* 릴리스 이력 (기존 평면 목록 대체) *@
    <div class="card">
        <div class="card-toolbar">
            <span class="toolbar-count">릴리스 이력 · @(releases.Count)개</span>
        </div>
        <table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th style="width:8rem">버전</th><th style="width:8rem">시행일</th><th>언어</th><th style="width:11rem">게시</th><th style="width:5rem"></th></tr></thead>
            <tbody>
                @if (releases.Count == 0)
                {
                    <tr><td colspan="5" class="empty-state"><span class="empty-icon">§</span>아직 게시된 릴리스가 없습니다. 4개 언어를 작성하고 "게시"하세요.</td></tr>
                }
                else
                {
                    @foreach (var rel in releases)
                    {
                        <tr>
                            <td class="font-monospace">
                                @rel.Version
                                @if (rel.IsCurrent) { <span class="badge bg-success ms-1">현재 공개</span> }
                            </td>
                            <td class="small text-muted">@(rel.EffectiveDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                            <td class="small text-muted font-monospace">@string.Join(" ", rel.Locales.Select(l => l.ToUpperInvariant()))</td>
                            <td class="small text-muted">@rel.PublishedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end row-actions">
                                <button class="btn btn-link btn-sm p-0" @onclick="() => LoadRelease(rel.Version)" disabled="@Busy">불러오기</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    // 정본(en) 우선. 게시는 이 전부가 작성돼야 가능(설계 결정 — 언어별 드리프트 차단).
    private static readonly string[] Locales = ["en", "ko", "ja", "es"];

    private string type = "terms";
    private string locale = "en";
    private readonly Dictionary<string, string> content = new();   // 로케일→초안 원문(인메모리 작업본)
    private readonly Dictionary<string, bool> published = new();    // 로케일→게시 여부(상태 점)
    private List<LegalReleaseRow> releases = [];
    private string version = "";
    private DateOnly? effectiveDate;
    private string tab = "edit";
    private string? msg;
    private bool err;

    private string CurrentContent
    {
        get => content.GetValueOrDefault(locale, "");
        set => content[locale] = value;
    }

    private IEnumerable<string> MissingLocales => Locales.Where(l => string.IsNullOrWhiteSpace(content.GetValueOrDefault(l)));
    private bool AllFilled => !MissingLocales.Any();
    private string PreviewHtml => Admin.Services.SafeMarkdown.ToHtml(CurrentContent);

    protected override async Task OnInitializedAsync() => await LoadType();

    private async Task SelectType(string t)
    {
        if (t == type) return;
        type = t;
        locale = "en";
        msg = null;
        await LoadType();
    }

    private async Task LoadType()
    {
        await LoadAsync(async () =>
        {
            foreach (var l in Locales)
            {
                var doc = await Db.GetLegalDocAsync(type, l);
                content[l] = doc?.Content ?? "";
                published[l] = doc?.Published ?? false;
            }
            releases = await Db.ListLegalReleasesAsync(type);
            version = releases.Count > 0 ? releases[0].Version : "";
            effectiveDate = null;
            tab = "edit";
        });
    }

    private async Task SaveDraft()
    {
        await RunAsync(async () =>
        {
            await Db.SaveLegalDraftAsync(type, locale, CurrentContent, await CurrentActor());
            err = false;
            msg = $"{LocaleLabel(locale)} 초안 저장됨";
        });
    }

    private async Task Publish()
    {
        if (string.IsNullOrWhiteSpace(version)) { err = true; msg = "버전을 입력하세요 (예: v1.0)."; return; }
        if (!AllFilled) { err = true; msg = $"미작성 언어: {string.Join(", ", MissingLocales.Select(l => l.ToUpperInvariant()))}"; return; }

        await RunAsync(async () =>
        {
            var snapshot = Locales.ToDictionary(l => l, l => content[l]);
            await Db.PublishLegalReleaseAsync(type, version, effectiveDate, snapshot, await CurrentActor());
            foreach (var l in Locales) published[l] = true;
            releases = await Db.ListLegalReleasesAsync(type);
            err = false;
            msg = $"게시됨 · {version} (4개 언어)";
        }, confirm: "4개 언어를 이 버전으로 게시할까요? 공개 사이트에 즉시 반영됩니다.");
    }

    // 과거 릴리스 내용을 편집기(초안)로 불러옴. 게시해야 공개 반영.
    private async Task LoadRelease(string ver)
    {
        await RunAsync(async () =>
        {
            var contents = await Db.GetLegalReleaseContentsAsync(type, ver, await CurrentActor());
            if (contents.Count == 0) return;
            foreach (var (l, c) in contents) content[l] = c;
            version = ver;
            tab = "edit";
            err = false;
            msg = $"릴리스 {ver} 내용을 편집기에 불러왔습니다 (게시해야 공개 반영).";
        });
    }

    private static string LocaleLabel(string l) => l.ToUpperInvariant();

    private async Task<Actor> CurrentActor()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        Guid? id = Guid.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var g) ? g : null;
        return new Actor(id, user.Identity?.Name ?? "?");
    }
}
