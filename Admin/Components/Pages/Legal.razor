@page "/legal"
@attribute [Authorize]
@rendermode InteractiveServer
@using Admin.Data
@using Microsoft.AspNetCore.Components.Authorization
@inject AdminDb Db
@inject AuthenticationStateProvider AuthState

<PageTitle>약관 · 개인정보</PageTitle>

<div class="page-header">
    <h1>약관 · 개인정보</h1>
    <p class="subtitle">이용약관/개인정보처리방침을 로케일별로 작성·게시합니다. 정본은 en.</p>
</div>

@if (!Db.Configured)
{
    <div class="alert alert-warning">DATABASE 설정이 없습니다.</div>
}
else
{
    <div class="card mb-4">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead><tr><th>종류</th><th>로케일</th><th>상태</th><th>최종 수정</th></tr></thead>
            <tbody>
                @if (docs.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">아직 문서가 없습니다.</td></tr>
                }
                else
                {
                    @foreach (var d in docs)
                    {
                        <tr class="@(loaded && d.Type == type && d.Locale == locale ? "table-active" : "")" style="cursor:pointer" @onclick="() => Load(d.Type, d.Locale)">
                            <td>@TypeLabel(d.Type)</td>
                            <td class="font-monospace">@d.Locale</td>
                            <td>
                                @if (d.Published)
                                {
                                    <span class="badge bg-success">게시</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">초안</span>
                                }
                            </td>
                            <td class="small text-muted">@d.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
                <select class="form-select form-select-sm" style="width:auto" @bind="type">
                    <option value="terms">이용약관</option>
                    <option value="privacy">개인정보처리방침</option>
                </select>
                <input class="form-control form-control-sm" style="width:110px" placeholder="로케일(en)" @bind="locale" />
                <button class="btn btn-sm btn-outline-secondary" @onclick="NewBlank">새 문서(비우기)</button>
                @if (published)
                {
                    <span class="badge bg-success">현재 게시됨</span>
                }
                @if (msg is not null)
                {
                    <span class="small text-success">@msg</span>
                }
            </div>

            <ul class="nav nav-tabs mb-2">
                <li class="nav-item"><button class="nav-link @(tab == "edit" ? "active" : "")" @onclick='() => tab = "edit"'>편집</button></li>
                <li class="nav-item"><button class="nav-link @(tab == "preview" ? "active" : "")" @onclick='() => tab = "preview"'>미리보기</button></li>
            </ul>

            @if (tab == "edit")
            {
                <textarea class="form-control font-monospace" rows="20" @bind="content" @bind:event="oninput" placeholder="마크다운으로 작성"></textarea>
            }
            else
            {
                <div class="border rounded p-3" style="min-height:24rem">@((MarkupString)PreviewHtml)</div>
            }

            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => Save(false)">초안 저장</button>
                <button class="btn btn-sm btn-primary" @onclick="() => Save(true)">게시</button>
            </div>
        </div>
    </div>
}

@code {
    private List<LegalDocRow> docs = [];
    private string type = "terms";
    private string locale = "en";
    private string content = "";
    private bool published;
    private bool loaded;      // 목록에서 불러온 상태(행 하이라이트용)
    private string tab = "edit";
    private string? msg;

    protected override async Task OnInitializedAsync() => await LoadList();

    private async Task LoadList() => docs = await Db.ListLegalDocsAsync();

    private async Task Load(string t, string l)
    {
        type = t;
        locale = string.IsNullOrWhiteSpace(l) ? "en" : l.Trim();
        msg = null;
        var doc = await Db.GetLegalDocAsync(type, locale);
        content = doc?.Content ?? "";
        published = doc?.Published ?? false;
        loaded = true;
        tab = "edit";
    }

    // 현재 종류/로케일로 새 문서 작성(편집기 비우기).
    private void NewBlank()
    {
        content = "";
        published = false;
        loaded = false;
        msg = null;
        tab = "edit";
    }

    private async Task Save(bool publish)
    {
        var loc = string.IsNullOrWhiteSpace(locale) ? "en" : locale.Trim();
        await Db.SaveLegalDocAsync(type, loc, content, publish, await CurrentActor());
        locale = loc;
        published = publish;
        loaded = true;
        msg = publish ? "게시됨" : "초안 저장됨";
        await LoadList();
    }

    private string PreviewHtml => Markdig.Markdown.ToHtml(content ?? "");

    private static string TypeLabel(string t) => t == "terms" ? "이용약관" : "개인정보";

    private async Task<Actor> CurrentActor()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        Guid? id = Guid.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var g) ? g : null;
        return new Actor(id, user.Identity?.Name ?? "?");
    }
}
