@inject NavigationManager Nav

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href=""><span class="glitter-brand">UmByul</span> Admin</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

@* 모바일 드로어 닫기: 링크 클릭 시에만(그룹 summary 토글은 제외) *@
<div class="nav-scrollable" onclick="if (event.target.closest('a')) document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> 홈
            </NavLink>
        </div>

        <details class="nav-group" open="@In("reports", "inquiries", "users")">
            <summary>모더레이션</summary>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="reports">
                    <span class="bi bi-flag-fill-nav-menu" aria-hidden="true"></span> 신고 처리
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="inquiries">
                    <span class="bi bi-flag-fill-nav-menu" aria-hidden="true"></span> 문의
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="users">
                    <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> 유저 관리
                </NavLink>
            </div>
        </details>

        <details class="nav-group" open="@In("reviews", "sets")">
            <summary>콘텐츠</summary>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="reviews">
                    <span class="bi bi-star-fill-nav-menu" aria-hidden="true"></span> 리뷰
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="sets">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> 믹스
                </NavLink>
            </div>
        </details>

        <details class="nav-group" open="@In("daily-picks", "youtube-links", "genres")">
            <summary>큐레이션</summary>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="daily-picks">
                    <span class="bi bi-star-fill-nav-menu" aria-hidden="true"></span> 오늘의 음악
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="youtube-links">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> YouTube 링크
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="genres">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> 장르
                </NavLink>
            </div>
        </details>

        <details class="nav-group" open="@In("announcements", "patch-notes", "faq", "legal")">
            <summary>소식 · 문서</summary>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="announcements">
                    <span class="bi bi-megaphone-nav-menu" aria-hidden="true"></span> 공지사항
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="patch-notes">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> 패치노트
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="faq">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> FAQ
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="legal">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> 약관 · 정책
                </NavLink>
            </div>
        </details>

        <details class="nav-group" open="@In("spotify", "admins", "audit", "app-logs")">
            <summary>시스템</summary>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="spotify">
                    <span class="bi bi-spotify-nav-menu" aria-hidden="true"></span> Spotify 상태
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admins">
                    <span class="bi bi-shield-nav-menu" aria-hidden="true"></span> 관리자
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="audit">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> 감사 로그
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="app-logs">
                    <span class="bi bi-graph-up-nav-menu" aria-hidden="true"></span> 시스템 로그
                </NavLink>
            </div>
        </details>
    </nav>

    <div class="session-footer border-top border-light border-opacity-10">
        <SessionBar @rendermode="InteractiveServer" />
    </div>
</div>

@code {
    // 현재 경로가 그룹에 속하면 해당 <details>를 열어 렌더(정적 SSR — 라우트 이동마다 재계산).
    private string Path => new Uri(Nav.Uri).AbsolutePath.Trim('/');
    private bool In(params string[] routes) =>
        routes.Any(r => Path == r || Path.StartsWith(r + "/", StringComparison.Ordinal));
}
