@inherits AdminPageBase
@using Admin.Data
@using Microsoft.AspNetCore.Components.Authorization
@inject AdminDb Db
@inject AuthenticationStateProvider AuthState
@inject SessionGuard Guard

@* 유저 제재 부여(경고/기간정지/영구정지/해제). 유저 관리·신고 화면에서 공통 사용. *@
<div class="d-flex flex-wrap align-items-center gap-1">
    <input class="form-control form-control-sm" style="width:150px" placeholder="사유(선택)" @bind="reason" />
    <input type="number" min="1" class="form-control form-control-sm" style="width:72px" @bind="amount" />
    <select class="form-select form-select-sm" style="width:auto" @bind="unit">
        <option value="hour">시간</option>
        <option value="day">일</option>
        <option value="month">월</option>
    </select>
    <button class="btn btn-sm btn-outline-warning" @onclick="Suspend" disabled="@Busy">정지</button>
    <button class="btn btn-sm btn-outline-secondary" @onclick="Warn" disabled="@Busy">경고</button>
    <button class="btn btn-sm btn-outline-danger" @onclick="Ban" disabled="@Busy">영구정지</button>
    <button class="btn btn-sm btn-outline-success" @onclick="Unban" disabled="@Busy">해제</button>
</div>
@if (msg is not null)
{
    <div class="small text-success mt-1">@msg</div>
}
@if (Error is not null)
{
    <div class="small text-danger mt-1">@Error</div>
}

@code {
    [Parameter, EditorRequired] public Guid UserId { get; set; }
    [Parameter] public Guid? ReportId { get; set; }
    [Parameter] public EventCallback OnDone { get; set; }

    private string reason = "";
    private int amount = 1;
    private string unit = "day";
    private string? msg;

    private Task Warn() => RunAsync(async () =>
    {
        using (Guard.Work())
            await Db.WarnUserAsync(UserId, R(), await CurrentActor(), ReportId);
        await Done("경고 부여됨");
    }, confirm: "이 사용자에게 경고를 부여할까요? 사용자에게 알림이 전송됩니다.");

    private async Task Suspend()
    {
        if (amount < 1) { msg = "기간은 1 이상이어야 합니다."; return; }
        var until = unit switch
        {
            "hour" => DateTimeOffset.UtcNow.AddHours(amount),
            "month" => DateTimeOffset.UtcNow.AddMonths(amount),
            _ => DateTimeOffset.UtcNow.AddDays(amount),
        };
        await RunAsync(async () =>
        {
            using (Guard.Work())
                await Db.SuspendUserAsync(UserId, until, R(), await CurrentActor(), ReportId);
            await Done($"정지: {until.ToLocalTime():yyyy-MM-dd HH:mm}까지");
        }, confirm: $"이 유저를 {until.ToLocalTime():yyyy-MM-dd HH:mm}까지 정지할까요?");
    }

    private Task Ban() => RunAsync(async () =>
    {
        using (Guard.Work())
            await Db.BanUserAsync(UserId, R(), await CurrentActor(), ReportId);
        await Done("영구정지됨");
    }, confirm: "이 유저를 영구정지할까요? 해제 전까지 작성이 차단됩니다.");

    private Task Unban() => RunAsync(async () =>
    {
        using (Guard.Work())
            await Db.UnbanUserAsync(UserId, await CurrentActor(), ReportId);
        await Done("해제됨");
    });

    private string? R() => string.IsNullOrWhiteSpace(reason) ? null : reason.Trim();

    private async Task Done(string m)
    {
        msg = m;
        reason = "";
        await OnDone.InvokeAsync();
    }

    private async Task<Actor> CurrentActor()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        Guid? id = Guid.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var g) ? g : null;
        return new Actor(id, user.Identity?.Name ?? "?");
    }
}
