@using Microsoft.AspNetCore.Components.Authorization
@using Admin.Services
@implements IDisposable
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject SessionGuard Guard

@* 사이드바 하단용: 로그인 계정 + 세션 잔여시간(hh:mm:ss) + 연장/로그아웃.
   만료 시 진행 중 작업 완료 후 로그아웃(NON-49/53/63). *@
@if (username is not null)
{
    <div class="px-3 py-3">
        <div class="fw-semibold text-white small text-truncate">@username</div>
        @if (waiting)
        {
            <div class="small text-warning">만료 — 작업 완료 후 로그아웃…</div>
        }
        else if (remaining is not null)
        {
            <div class="small text-white-50">세션 <span class="font-monospace">@remaining</span></div>
        }
        <div class="d-flex gap-1 mt-2">
            <form method="post" action="/auth/refresh" class="d-inline">
                <button type="submit" class="btn btn-sm btn-outline-light">연장</button>
            </form>
            <form method="post" action="/auth/logout" class="d-inline">
                <button type="submit" class="btn btn-sm btn-outline-light">로그아웃</button>
            </form>
        </div>
    </div>
}

@code {
    private string? username;
    private DateTimeOffset? expiresAt;
    private string? remaining;
    private bool waiting; // 만료됐지만 진행 중 작업 대기 중
    private Timer? timer;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        if (user.Identity?.IsAuthenticated != true) return;
        username = user.Identity.Name;
        if (long.TryParse(user.FindFirst("session_exp")?.Value, out var unix))
            expiresAt = DateTimeOffset.FromUnixTimeSeconds(unix);
        Tick(null);
        timer = new Timer(Tick, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void Tick(object? _)
    {
        if (expiresAt is not { } e) return;
        var left = e - DateTimeOffset.UtcNow;
        if (left <= TimeSpan.Zero)
        {
            remaining = "00:00:00";
            if (Guard.Busy) // 진행 중 작업이 끝날 때까지 로그아웃 보류(다음 tick에 재확인).
            {
                waiting = true;
                InvokeAsync(StateHasChanged);
                return;
            }
            timer?.Dispose();
            timer = null;
            InvokeAsync(() => Nav.NavigateTo("/auth/logout", forceLoad: true));
            return;
        }
        waiting = false;
        remaining = $"{(int)left.TotalHours:D2}:{left.Minutes:D2}:{left.Seconds:D2}";
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        timer?.Dispose();
        timer = null;
    }
}
