@* 로케일 세그먼트 전환(공지·패치노트·FAQ 공통). Status 주면 로케일별 완성 여부를 점으로 표시. *@
<div class="d-flex flex-wrap align-items-center gap-1">
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="lg-loclabel me-1">@Label</span>
    }
    @foreach (var l in Locales)
    {
        var done = Status is not null && Status.TryGetValue(l, out var v) && v;
        <button type="button"
                class="btn btn-sm @(l == Selected ? "btn-primary" : "btn-outline-secondary")"
                @onclick="() => OnSelect.InvokeAsync(l)" disabled="@Disabled">
            @if (Status is not null)
            {
                <span class="legal-dot @(done ? "dot-pub" : "dot-empty")"></span>
            }
            @l.ToUpperInvariant()
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<string> Locales { get; set; } = [];
    [Parameter] public string Selected { get; set; } = "";
    // 있으면 로케일별 완성 여부 점(초록=완성, 회색=미완). 없으면 점 미표시(단순 필터/전환용).
    [Parameter] public Dictionary<string, bool>? Status { get; set; }
    [Parameter] public EventCallback<string> OnSelect { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Disabled { get; set; }
}
